{
  "uid": "iguard-linux",
  "title": "Linux Server Monitoring",
  "tags": [
    "iguard",
    "linux",
    "node-exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "iguard-prometheus"
        },
        "label": "Host",
        "refresh": 2,
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "v"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "title": "CPU %",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "avg(iguard:node_cpu_usage_percent{instance=~\"$instance\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Memory %",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "avg(iguard:node_memory_usage_percent{instance=~\"$instance\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "gauge",
      "title": "Root disk %",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "max(iguard:node_disk_usage_percent{instance=~\"$instance\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "time() - max(node_boot_time_seconds{instance=~\"$instance\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "CPU usage (host)",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "iguard:node_cpu_usage_percent{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "CPU per core",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "iguard:node_cpu_core_usage_percent{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} cpu{{cpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Load average",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_load1{instance=~\"$instance\"}",
          "legendFormat": "1m {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_load5{instance=~\"$instance\"}",
          "legendFormat": "5m {{instance}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_load15{instance=~\"$instance\"}",
          "legendFormat": "15m {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{instance=~\"$instance\"}",
          "legendFormat": "total {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_memory_MemTotal_bytes{instance=~\"$instance\"} - node_memory_MemAvailable_bytes{instance=~\"$instance\"}",
          "legendFormat": "used {{instance}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_memory_MemAvailable_bytes{instance=~\"$instance\"}",
          "legendFormat": "available {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Filesystem usage",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "100 - node_filesystem_avail_bytes{instance=~\"$instance\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs|rootfs\"} / node_filesystem_size_bytes{instance=~\"$instance\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs|rootfs\"} * 100",
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Disk I/O throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{instance=~\"$instance\"}[2m]))",
          "legendFormat": "read {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_disk_written_bytes_total{instance=~\"$instance\"}[2m]))",
          "legendFormat": "write {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Disk I/O utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "max by (instance) (rate(node_disk_io_time_seconds_total{instance=~\"$instance\"}[2m])) * 100",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*\"}[2m]))",
          "legendFormat": "rx {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*\"}[2m]))",
          "legendFormat": "tx {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Network errors & drops",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_receive_errs_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*\"}[2m]))",
          "legendFormat": "rx errors {{instance}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_transmit_errs_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*\"}[2m]))",
          "legendFormat": "tx errors {{instance}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_receive_drop_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*\"}[2m]))",
          "legendFormat": "rx drops {{instance}}"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_transmit_drop_total{instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*\"}[2m]))",
          "legendFormat": "tx drops {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "spanNulls": false,
            "lineWidth": 1,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Host information",
      "datasource": {
        "type": "prometheus",
        "uid": "iguard-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "iguard-prometheus"
          },
          "expr": "node_uname_info{instance=~\"$instance\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 6
      }
    }
  ]
}
