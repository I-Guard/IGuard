# Copy to .env (scripts/install.sh does this and generates random secrets). NEVER commit .env.
# All values marked REQUIRED must be set; docker compose refuses to start without them.

# --- Secrets (REQUIRED) -------------------------------------------------------------------
# Use url-safe alphanumerics only (openssl rand -hex 32). Do not reuse across variables.
IGUARD_SECRET_KEY=
IGUARD_WEBHOOK_TOKEN=
RECOVERY_AGENT_SECRET=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Environment ---------------------------------------------------------------------------
IGUARD_ENV=development            # development | production (see docker-compose.prod.yml)
IGUARD_BIND_ADDR=127.0.0.1        # 0.0.0.0 exposes the UI/Grafana to the network - put TLS in front first
IGUARD_HTTP_PORT=8080
GRAFANA_PORT=3000
IGUARD_CORS_ORIGINS=http://localhost:8080
IGUARD_COOKIE_SECURE=false        # must be true behind HTTPS

# --- First administrator (optional) ---------------------------------------------------------
# Created only if the users table is empty. Alternatively: scripts/create-admin.sh
IGUARD_BOOTSTRAP_ADMIN_EMAIL=
IGUARD_BOOTSTRAP_ADMIN_PASSWORD=

# --- Demo data (development only) -----------------------------------------------------------
# IGUARD_SEED_DEMO=true creates demo-admin/demo-operator/demo-viewer. Passwords are generated
# randomly and printed once in the backend log (docker compose logs backend | grep "demo user"),
# unless IGUARD_SEED_PASSWORD is set.
IGUARD_SEED_DEMO=true
IGUARD_SEED_PASSWORD=
DEMO_CONTROL_ENABLED=true         # failure-injection endpoints of the synthetic services

# --- Recovery ---------------------------------------------------------------------------------
# agent     = real restarts of allowlisted containers through the recovery agent
# simulated = no host changes at all (safe for evaluation without Docker access)
IGUARD_RECOVERY_ADAPTER=agent

# --- Telegram (optional; the system works without it) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
